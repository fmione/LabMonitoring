# Directorio BASE del host donde viven los experimentos/ejecuciones.
# Es un detalle interno de la app: se monta en /data en el contenedor y en la
# web se ingresa solo el NOMBRE de la ejecucion (ej: Pio_emu) que se resuelve
# contra esta base. Usar una ruta absoluta.
EXPMON_DATA_DIR_HOST=/home/usuario/Documentos/Airflow

# Puerto web expuesto en el host
EXPMON_PORT=8100

# Intervalo de refresco por defecto (ms)
EXPMON_REFRESH_MS=5000

# Zona horaria para mostrar las fechas
EXPMON_TZ=Etc/GMT+3